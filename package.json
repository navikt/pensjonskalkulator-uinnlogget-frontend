{
  "name": "pensjonskalkulator-uinnlogget-frontend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "next build && pnpm build:server",
    "build:prod": "cp .env.prod .env && next build && pnpm build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "next start",
    "dev": "concurrently -k \"next dev --turbo\" \"json-server mockdb/db.json --port 3001\"",
    "fetch-dev-types": "openapi-typescript https://pensjonskalkulator-backend.intern.dev.nav.no/v3/api-docs/current -o ./src/types/schema.d.ts",
    "generate-types": "openapi-typescript https://www.nav.no/pensjon/kalkulator/v3/api-docs/current -o ./src/types/schema.d.ts && pnpm format:types",
    "format:types": "prettier --write ./src/types/schema.d.ts && eslint ./src/types/schema.d.ts --fix",
    "test": "jest",
    "testc": "jest --c",
    "typecheck": "tsc --noEmit --pretty -p tsconfig.json && tsc --noEmit --pretty -p tsconfig.server.json",
    "lint": "eslint .",
    "prettier:fix": "prettier --write '**/*.{cjs,js,jsx,ts,tsx,json}'",
    "prepare": "if [ -z \"$CI\" ]; then husky; fi"
  },
  "packageManager": "pnpm@10.11.0",
  "dependencies": {
    "@navikt/ds-css": "^7.40.0",
    "@navikt/ds-react": "^7.40.0",
    "@navikt/nav-dekoratoren-moduler": "^3.7.3",
    "@navikt/oasis": "^3.8.0",
    "@navikt/steng-for-regulering": "^0.0.7",
    "express": "^5.2.1",
    "highcharts": "^12.6.2",
    "highcharts-react-official": "^3.2.3",
    "immer": "^10.2.0",
    "next": "15.5.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.13.6",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "babel-jest": "^30.5.2",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.24",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^29.1.1",
    "json-server": "1.0.0-beta.15",
    "lint-staged": "^16.4.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "lint-staged": {
    "**/*.{cjs,js,jsx,ts,tsx}": "eslint --fix",
    "**/*.{cjs,js,jsx,ts,tsx,css}": "prettier --write"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.1.10",
      "@types/react-dom": "19.1.7",
      "jsdom>parse5": "^7.1.2",
      "@ungap/structured-clone@<1.3.1": "1.3.1",
      "lodash": "4.18.1",
      "qs@>=6.11.1 <=6.15.1": "6.15.2",
      "js-cookie@<=3.0.5": "3.0.7",
      "shell-quote@<=1.8.4": "1.9.0",
      "@babel/core@<=7.29.0": "7.29.6",
      "body-parser@>=2.0.0 <2.3.0": "2.3.0",
      "sharp@<0.35.0": "0.35.0",
      "postcss@<=8.5.22": "8.5.23",
      "ip-address@<=10.3.0": "10.3.1",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "undici@>=7.0.0 <7.29.0": "7.29.0",
      "next@>=12.0.0 <15.5.24": "15.5.24",
      "nanoid@<3.3.18": "3.3.18",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "brace-expansion@>=3.0.0 <5.0.9": "5.0.9",
      "js-yaml@>=3.0.0 <3.15.1": "3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1"
    },
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ]
  }
}